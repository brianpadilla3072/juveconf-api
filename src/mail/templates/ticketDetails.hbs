<html>
  <body>
    <p>Hola {{name}},</p>
    <p>Estos son los detalles de su ticket para el evento:</p>
    <ul>
      <li>Evento: {{eventTopic}}</li>
      <li>Fecha de venta: {{salesStartDate}}</li>
      <li>Invitados:</li>
      {{#each invitees}}
        <li>{{this.name}} - DNI: {{this.dni}}</li>
      {{/each}}
    </ul>
  </body>
</html>