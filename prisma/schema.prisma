generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Combo {
  id                String              @id
  name              String
  price             Float
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  eventId           String
  description       String?
  displayOrder      Int                 @default(0)
  isActive          Boolean             @default(true)
  isFree            Boolean             @default(false)
  isPublished       Boolean             @default(false)
  maxPersons        Int?
  metadata          Json?
  personsIncluded   Int
  Event             Event               @relation(fields: [eventId], references: [id])
  Order             Order[]
  PreSaleComboPrice PreSaleComboPrice[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
}

model Egreso {
  id         String    @id
  fecha      DateTime
  concepto   String
  monto      Float
  metodoPago String
  notas      String?
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?

  @@index([year, fecha])
}

model EmailQueue {
  id            String      @id
  to            String
  subject       String
  html          String?
  template      String?
  context       Json?
  emailType     EmailType
  orderId       String?
  paymentId     String?
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Order         Order?      @relation(fields: [orderId], references: [id])
  Payment       Payment?    @relation(fields: [paymentId], references: [id])

  @@index([createdAt])
  @@index([status, attempts])
}

model Event {
  id             String    @id
  year           Int
  topic          String
  capacity       Int
  salesStartDate DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  description    String?
  eventDays      Json?
  eventEndDate   DateTime?
  eventStartDate DateTime?
  isActive       Boolean   @default(true)
  location       String?
  salesEndDate   DateTime?
  Combo          Combo[]
  Order          Order[]
  PreSale        PreSale[]

  @@index([eventStartDate])
  @@index([salesStartDate])
  @@index([year])
}

model Ingreso {
  id         String    @id
  fecha      DateTime
  concepto   String
  monto      Float
  metodoPago String
  notas      String?
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?

  @@index([year, fecha])
}

model Invitee {
  id         String    @id
  name       String
  cuil       String
  orderId    String?
  paymentId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?
  email      String?
  phone      String?
  attendance Json?
  metadata   String?
  Order      Order?    @relation(fields: [orderId], references: [id])
  Payment    Payment?  @relation(fields: [paymentId], references: [id])

  @@index([cuil])
  @@index([email])
  @@index([orderId])
  @@index([paymentId])
}

model Order {
  id                String       @id
  year              Int
  userId            String?
  eventId           String
  total             Float
  status            OrderStatus  @default(PENDING)
  paymentType       PaymentType
  externalReference String?      @unique
  metadataToken     String?
  preferenceId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  cuil              String
  email             String
  phone             String?
  comboId           String
  orderSnapshot     Json?
  EmailQueue        EmailQueue[]
  Invitee           Invitee[]
  Combo             Combo        @relation(fields: [comboId], references: [id])
  Event             Event        @relation(fields: [eventId], references: [id])
  User              User?        @relation(fields: [userId], references: [id])
  Payment           Payment[]

  @@index([comboId])
  @@index([createdAt])
  @@index([cuil])
  @@index([email])
  @@index([eventId])
  @@index([status, paymentType])
  @@index([userId])
}

model Payment {
  id                String       @id
  year              Int
  orderId           String
  amount            Float
  type              PaymentType
  externalReference String?
  userId            String?
  payerName         String?
  payerEmail        String?
  payerDni          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  payerPhone        String?
  EmailQueue        EmailQueue[]
  Invitee           Invitee[]
  Order             Order        @relation(fields: [orderId], references: [id])
  User              User?        @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([orderId])
  @@index([type])
  @@index([userId])
}

model PreSale {
  id                String              @id
  eventId           String
  startDate         DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  description       String?
  endDate           DateTime
  isActive          Boolean             @default(true)
  name              String
  Event             Event               @relation(fields: [eventId], references: [id])
  PreSaleComboPrice PreSaleComboPrice[]

  @@unique([eventId, name])
  @@index([eventId, startDate, endDate])
}

model PreSaleComboPrice {
  id        String   @id
  preSaleId String
  comboId   String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime
  Combo     Combo    @relation(fields: [comboId], references: [id])
  PreSale   PreSale  @relation(fields: [preSaleId], references: [id], onDelete: Cascade)

  @@unique([preSaleId, comboId])
  @@index([comboId])
  @@index([preSaleId])
}

model User {
  id                    String       @id
  auth0Id               String?      @unique
  provider              AuthProvider @default(LOCAL)
  dni                   String       @unique
  name                  String
  givenName             String?
  familyName            String?
  nickname              String?
  email                 String       @unique
  emailVerified         Boolean      @default(false)
  picture               String?
  locale                String?
  password              String?
  role                  UserRole     @default(USER)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime
  lastLogin             DateTime?
  deletedAt             DateTime?
  requirePasswordChange Boolean      @default(false)
  Order                 Order[]
  Payment               Payment[]

  @@index([dni])
  @@index([email, deletedAt])
  @@index([role])
}

enum AuthProvider {
  LOCAL
  AUTH0
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailType {
  ORDEN_TRANSFER
  ORDEN_CASH
  TICKET_DOWNLOAD
  PASSWORD_RESET
  CUSTOM
}

enum OrderStatus {
  PENDING
  REVIEW
  PAID
  CANCELLED
}

enum PaymentType {
  TRANSFER
  MERCADOPAGO
  CASH
}

enum UserRole {
  SUPERADMIN
  DEVELOPER
  ADMIN
  EDITOR
  COLLABORATOR
  USER
}
