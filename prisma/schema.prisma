generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Combo {
  id                String              @id @default(uuid())
  name              String
  price             Float
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  eventId           String
  description       String?
  displayOrder      Int                 @default(0)
  isActive          Boolean             @default(true)
  isFree            Boolean             @default(false)
  isPublished       Boolean             @default(false)
  mealsEnabled      Boolean             @default(false)
  maxPersons        Int?
  metadata          Json?
  personsIncluded   Int
  Event             Event               @relation(fields: [eventId], references: [id])
  Order             Order[]
  PreSaleComboPrice PreSaleComboPrice[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
}

model Egreso {
  id         String    @id @default(uuid())
  fecha      DateTime
  concepto   String
  monto      Float
  metodoPago String
  notas      String?
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([year, fecha])
}

model EmailQueue {
  id            String      @id @default(uuid())
  to            String
  subject       String
  html          String?
  template      String?
  context       Json?
  emailType     EmailType
  orderId       String?
  paymentId     String?
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Order         Order?      @relation(fields: [orderId], references: [id])
  Payment       Payment?    @relation(fields: [paymentId], references: [id])

  @@index([createdAt])
  @@index([status, attempts])
}

model Event {
  id             String    @id @default(uuid())
  year           Int
  topic          String
  capacity       Int
  salesStartDate DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  description    String?
  eventDays      Json?
  eventEndDate   DateTime?
  eventStartDate DateTime?
  isActive       Boolean   @default(true)
  location       String?
  salesEndDate   DateTime?
  mealConfig     Json?
  registrationSeq Int      @default(0)
  Combo          Combo[]
  Order          Order[]
  PreSale        PreSale[]
  TeamType       TeamType[]

  @@index([eventStartDate])
  @@index([salesStartDate])
  @@index([year])
}

model Ingreso {
  id         String    @id @default(uuid())
  fecha      DateTime
  concepto   String
  monto      Float
  metodoPago String
  notas      String?
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([year, fecha])
}

model Invitee {
  id         String    @id @default(uuid())
  name       String
  cuil       String
  orderId    String?
  paymentId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  email      String?
  phone      String?
  attendance Json?
  metadata   String?
  registrationCode String? @unique
  Order      Order?    @relation(fields: [orderId], references: [id])
  Payment    Payment?  @relation(fields: [paymentId], references: [id])
  MealSelection MealSelection[]
  TeamPlayer TeamPlayer[]

  @@index([cuil])
  @@index([email])
  @@index([orderId])
  @@index([paymentId])
}

model Order {
  id                String       @id @default(uuid())
  year              Int
  userId            String?
  eventId           String
  total             Float
  status            OrderStatus  @default(PENDING)
  paymentType       PaymentType
  externalReference String?      @unique
  metadataToken     String?
  preferenceId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  cuil              String
  email             String
  phone             String?
  comboId           String
  orderSnapshot     Json?
  proofSent         Boolean      @default(false)
  EmailQueue        EmailQueue[]
  Invitee           Invitee[]
  Combo             Combo        @relation(fields: [comboId], references: [id])
  Event             Event        @relation(fields: [eventId], references: [id])
  User              User?        @relation(fields: [userId], references: [id])
  Payment           Payment[]

  @@index([comboId])
  @@index([createdAt])
  @@index([cuil])
  @@index([email])
  @@index([eventId])
  @@index([status, paymentType])
  @@index([userId])
}

model Payment {
  id                String       @id @default(uuid())
  year              Int
  orderId           String
  amount            Float
  type              PaymentType
  externalReference String?
  userId            String?
  payerName         String?
  payerEmail        String?
  payerDni          String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  payerPhone        String?
  EmailQueue        EmailQueue[]
  Invitee           Invitee[]
  Order             Order        @relation(fields: [orderId], references: [id])
  User              User?        @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([orderId])
  @@index([type])
  @@index([userId])
}

model PreSale {
  id                String              @id @default(uuid())
  eventId           String
  startDate         DateTime
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  description       String?
  endDate           DateTime
  isActive          Boolean             @default(true)
  name              String
  Event             Event               @relation(fields: [eventId], references: [id])
  PreSaleComboPrice PreSaleComboPrice[]

  @@unique([eventId, name])
  @@index([eventId, startDate, endDate])
}

model PreSaleComboPrice {
  id        String   @id @default(uuid())
  preSaleId String
  comboId   String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Combo     Combo    @relation(fields: [comboId], references: [id])
  PreSale   PreSale  @relation(fields: [preSaleId], references: [id], onDelete: Cascade)

  @@unique([preSaleId, comboId])
  @@index([comboId])
  @@index([preSaleId])
}

model User {
  id                    String       @id @default(uuid())
  auth0Id               String?      @unique
  provider              AuthProvider @default(LOCAL)
  dni                   String       @unique
  name                  String
  givenName             String?
  familyName            String?
  nickname              String?
  email                 String       @unique
  emailVerified         Boolean      @default(false)
  picture               String?
  locale                String?
  password              String?
  role                  UserRole     @default(USER)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  lastLogin             DateTime?
  deletedAt             DateTime?
  requirePasswordChange Boolean      @default(false)
  Order                 Order[]
  Payment               Payment[]

  @@index([dni])
  @@index([email, deletedAt])
  @@index([role])
}

enum AuthProvider {
  LOCAL
  AUTH0
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum EmailType {
  ORDEN_TRANSFER
  ORDEN_CASH
  TICKET_DOWNLOAD
  PASSWORD_RESET
  CUSTOM
}

enum OrderStatus {
  PENDING
  REVIEW
  PAID
  CANCELLED
}

enum PaymentType {
  TRANSFER
  MERCADOPAGO
  CASH
}

enum UserRole {
  SUPERADMIN
  DEVELOPER
  ADMIN
  EDITOR
  COLLABORATOR
  BUFFET
  USER
}

model MealSelection {
  id            String    @id @default(uuid())
  inviteeId     String
  orderId       String
  slotCode      String
  optionNumber  Int
  optionName    String
  price         Float
  deliveredAt   DateTime?
  deliveredById String?
  createdAt     DateTime  @default(now())
  Invitee       Invitee   @relation(fields: [inviteeId], references: [id])

  @@unique([inviteeId, slotCode])
  @@index([orderId])
  @@index([slotCode, optionNumber])
  @@index([slotCode, deliveredAt])
}

// Tipo de equipo/actividad configurable por evento (futbol femenino, voley masculino, jenga, juegos de mesa...)
model TeamType {
  id           String    @id @default(uuid())
  eventId      String
  name         String
  description  String?
  minPlayers   Int       @default(1)
  maxPlayers   Int       @default(10)
  // null = sin limite de equipos
  maxTeams     Int?
  // Precio de inscripcion del equipo; 0 = gratis (hoy no se cobra, queda para el futuro)
  price        Float     @default(0)
  isActive     Boolean   @default(true)
  isPublished  Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  Event        Event     @relation(fields: [eventId], references: [id])
  Team         Team[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
}

model Team {
  id          String       @id @default(uuid())
  teamTypeId  String
  name        String
  leaderName  String
  leaderPhone String
  leaderEmail String?
  // Link privado: permite al lider editar su equipo sin tener cuenta
  editToken   String       @unique @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  TeamType    TeamType     @relation(fields: [teamTypeId], references: [id])
  TeamPlayer  TeamPlayer[]

  @@unique([teamTypeId, name])
  @@index([teamTypeId])
}

model TeamPlayer {
  id        String   @id @default(uuid())
  teamId    String
  firstName String
  lastName  String
  // Vinculo opcional con una entrada (hoy siempre null)
  inviteeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Invitee   Invitee? @relation(fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([inviteeId])
}
