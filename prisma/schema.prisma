// Aplicación de consorcios ("events") con múltiples preventas, pagos independientes,
// registro de invitados y campos de auditoría (createdAt, updatedAt, deletedAt)

generator client {
  provider = "prisma-client-js"
  // output = "../generated/prisma" // Habilitar si desea customizar el path
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enumeraciones
enum UserRole {
  SUPERADMIN
  DEVELOPER
  ADMIN
  EDITOR
  COLLABORATOR
  USER
}

enum PaymentType {
  TRANSFER
  MERCADOPAGO
}

enum AuthProvider {
  LOCAL
  AUTH0
}

// Modelos principales
model User {
  id              String       @id @default(uuid())
  auth0Id         String?      @unique
  provider        AuthProvider @default(LOCAL)
  dni             String       @unique
  name            String
  givenName       String?
  familyName      String?
  nickname        String?
  email           String       @unique
  emailVerified   Boolean      @default(false)
  picture         String?
  locale          String?
  password        String?      // Opcional si el usuario se registra vía Auth0
  role            UserRole     @default(USER)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastLogin       DateTime?
  deletedAt       DateTime?

  orders          Order[]
  payments        Payment[]
}

model Event {
  id              String       @id @default(uuid())
  year            Int
  topic           String
  capacity        Int
  salesStartDate  DateTime

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  preSales        PreSale[]
  orders          Order[]
  combos          Combo[]      // Relación inversa agregada
}

model Combo {
  id              String       @id @default(uuid())
  name            String
  price           Float
  year            Int
  minPersons      Int

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  eventId         String
  event           Event        @relation(fields: [eventId], references: [id])

  orders          Order[]

  @@unique([name, year]) // Evita duplicar combos con el mismo nombre en el mismo año
}

model PreSale {
  id              String       @id @default(uuid())
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id])

  discountPercent Float
  startDate       DateTime
  ticketQuantity  Int
  year            Int

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
}

model Order {
  id                String       @id @default(uuid())
  year              Int
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])

  eventId           String
  event             Event        @relation(fields: [eventId], references: [id])

  combos            Combo[]      // Relación many-to-many implícita

  total             Float
  status            String       @default("pending")
  paymentType       PaymentType
  externalReference String? @unique
  metadataToken     String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  payments          Payment[]
  invitees          Invitee[]
}

model Payment {
  id                String       @id @default(uuid())
  year              Int

  orderId           String
  order             Order        @relation(fields: [orderId], references: [id])

  amount            Float
  type              PaymentType
  externalReference String?

  userId            String?
  user              User?        @relation(fields: [userId], references: [id])

  payerName         String?
  payerEmail        String?
  payerDni          String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  invitees          Invitee[]
}

model Invitee {
  id              String        @id @default(uuid())
  name            String
  dni             String

  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])

  paymentId       String?
  payment         Payment?      @relation(fields: [paymentId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
}
